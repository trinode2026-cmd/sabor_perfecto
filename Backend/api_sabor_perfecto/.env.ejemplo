# Conexion a la base de datos MariaDB
BD_MOTOR=mariadb
BD_HOST=
BD_PUERTO=3306
BD_USUARIO=
BD_CONTRASENA=
BD_NOMBRE=sabor_perfecto

# Donde escucha la API (cambia el puerto cuando quieras)
API_HOST=127.0.0.1
API_PUERTO=8000
RECARGA_AUTOMATICA=true

# Configuracion general de la API
NOMBRE_APP=Sabor Perfecto API
ENTORNO=desarrollo
PREFIJO_API=/api
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173
LIMITE_OPCIONES=8
MONEDA=MXN
